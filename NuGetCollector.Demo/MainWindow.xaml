<Window x:Class="NuGetCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NuGet Collector" Width="900" Height="560" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="InputPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="_Solutions folder:" Target="{Binding ElementName=SourceBox}" />
            <TextBox x:Name="SourceBox" Grid.Column="1" Margin="6,2" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." Padding="12,2" Margin="0,2"
                    Click="BrowseSource_Click" />

            <Label Grid.Row="1" Content="_Target folder:" Target="{Binding ElementName=TargetBox}" />
            <TextBox x:Name="TargetBox" Grid.Row="1" Grid.Column="1" Margin="6,2"
                     VerticalContentAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Padding="12,2" Margin="0,2"
                    Click="BrowseTarget_Click" />

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,6,0,0">
                <CheckBox x:Name="PackBox" Content="_Pack projects that are ahead of the target (Release)" />
                <CheckBox x:Name="IncludeNewBox" Margin="20,4,0,0"
                          Content="Also pack projects _not yet in the target"
                          IsEnabled="{Binding IsChecked, ElementName=PackBox}" />
            </StackPanel>

            <Button Grid.Row="3" Grid.Column="1" Content="Scan and _update" HorizontalAlignment="Left"
                    Padding="18,5" Margin="6,8" Click="Run_Click" />
        </Grid>

        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Package" Binding="{Binding Id}" Width="2*" />
                <DataGridTextColumn Header="New version" Binding="{Binding Version}" Width="Auto" />
                <DataGridTextColumn Header="Existing version" Binding="{Binding PreviousVersion}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourcePath}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <Expander x:Name="WarningsPanel" Grid.Row="2" Header="Warnings" Margin="0,8,0,0"
                  Visibility="Collapsed">
            <ListBox x:Name="WarningsList" MaxHeight="120" />
        </Expander>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Text="Ready." />
    </Grid>
</Window>
