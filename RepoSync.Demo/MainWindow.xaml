<Window x:Class="RepoSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bk="clr-namespace:BranchKit;assembly=BranchKit"
        Title="Repo Sync" Icon="Assets/app.ico" Height="600" Width="900">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>
    <!-- Faint tint after an update: green = updated, grey-blue = no changes -->
    <Style x:Key="OutcomeCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Outcome}" Value="updated"><Setter Property="Background" Value="#4090EE90"/></DataTrigger>
        <DataTrigger Binding="{Binding Outcome}" Value="unchanged"><Setter Property="Background" Value="#40B0C4DE"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="GitHub profile:" VerticalAlignment="Center"/>
      <TextBox x:Name="UserBox" Width="150" Margin="6,0,12,0"/>
      <TextBlock Text="Token (optional):" VerticalAlignment="Center"/>
      <PasswordBox x:Name="TokenBox" Width="150" Margin="6,0,12,0"/>
      <Button x:Name="LoadBtn" Content="Load repos" Padding="12,2" Click="Load_Click"/>
      <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="24,0,6,0"/>
      <ComboBox x:Name="ThemeBox" Width="90"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="Local folder:" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,2" Click="Browse_Click"/>
      <TextBox x:Name="FolderBox" Margin="6,0,6,0"/>
    </DockPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Text="NuGet feed:" VerticalAlignment="Center"/>
      <CheckBox x:Name="IncludeNewBox" DockPanel.Dock="Right" Content="Include libraries not yet in feed" VerticalAlignment="Center" Margin="12,0,0,0"
                ToolTip="Also allow Pack for libraries that have never been packed into the feed" Click="IncludeNew_Click"/>
      <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,2" Click="BrowseFeed_Click"/>
      <TextBox x:Name="FeedBox" Margin="6,0,6,0" LostFocus="Feed_LostFocus"/>
    </DockPanel>
    <Grid Grid.Row="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
    <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Repo" Binding="{Binding Name}" IsReadOnly="True" Width="250"/>
        <DataGridTextColumn Header="Branch" Binding="{Binding BranchShown}" IsReadOnly="True" Width="130"/>
        <DataGridTextColumn Header="Last commit" Binding="{Binding CommitShown}" IsReadOnly="True" Width="250"/>
        <DataGridTemplateColumn Header="" Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Button Content="Update" Padding="8,0" Margin="2" Click="RowUpdate_Click"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <Button Content="{Binding PackText}" IsEnabled="{Binding PackEnabled}" ToolTip="{Binding PackTip}"
                        Padding="8,0" Margin="2" MinWidth="70" Click="RowPack_Click"/>
                <!-- loading sign while scanning or packing: the button stays disabled -->
                <ProgressBar IsIndeterminate="True" Height="3" MaxWidth="80" VerticalAlignment="Bottom" Margin="6,0,6,4"
                             IsHitTestVisible="False" Visibility="{Binding PackBusy, Converter={StaticResource B2V}}"/>
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <!-- split button: Open runs the default solution; the arrow (several solutions only) lists them all -->
              <StackPanel Orientation="Horizontal">
                <Button Content="Open" IsEnabled="{Binding OpenEnabled}" ToolTip="{Binding OpenTip}"
                        Padding="8,0" Margin="2,2,0,2" Click="RowOpen_Click"/>
                <Button Content="▾" Padding="4,0" Margin="0,2,2,2" ToolTip="Choose a solution"
                        Visibility="{Binding HasManySolutions, Converter={StaticResource B2V}}" Click="RowOpenMenu_Click"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridCheckBoxColumn Header="Private" Binding="{Binding Private}" IsReadOnly="True"/>
        <DataGridTextColumn Header="Last updated" Binding="{Binding LastUpdatedText}" SortMemberPath="LastUpdated" IsReadOnly="True" Width="100">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="ToolTip" Value="{Binding LastUpdated, StringFormat=dddd dd MMM yyyy HH:mm}"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTemplateColumn Header="Status" SortMemberPath="StatusIcon" Width="60" CellStyle="{StaticResource OutcomeCell}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StatusIcon}" ToolTip="{Binding Detail}" HorizontalAlignment="Center"
                         FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold" Background="Transparent">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StatusIcon}" Value="✔"><Setter Property="Foreground" Value="#16A34A"/></DataTrigger>
                      <DataTrigger Binding="{Binding StatusIcon}" Value="✘"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger>
                      <DataTrigger Binding="{Binding StatusIcon}" Value="↻"><Setter Property="Foreground" Value="#D97706"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Message" Binding="{Binding Message}" IsReadOnly="True" Width="*" CellStyle="{StaticResource OutcomeCell}"/>
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
    <DockPanel Grid.Column="2">
      <TextBlock x:Name="GraphInfo" DockPanel.Dock="Top" Margin="6,0,0,4" Foreground="Gray" Text="Select a repo to see its branches"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <bk:BranchGraphView x:Name="Graph" RowHeight="24"/>
      </ScrollViewer>
    </DockPanel>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Select all" Padding="12,2" Click="SelectAll_Click"/>
      <Button Content="Select none" Padding="12,2" Margin="6,0" Click="SelectNone_Click"/>
      <Button x:Name="CheckBtn" Content="Check for updates" Padding="12,2" Margin="0,0,6,0" Click="Check_Click"/>
      <Button x:Name="UpdateBtn" Content="Pull latest &amp; checkout latest branch" Padding="12,2" Click="Update_Click"/>
      <TextBlock x:Name="CheckText" Margin="16,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="SavedText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
    </StackPanel>
  </Grid>
</Window>
