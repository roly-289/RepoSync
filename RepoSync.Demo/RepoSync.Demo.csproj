<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.21.1</Version>
    <!-- Application.ThemeMode (Fluent light/dark) is still marked experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- NuGetCollector is its own project in this repo; keep its files out of RepoSync -->
 
    <PackageReference Include="BranchKit" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NuGetCollector.Core\NuGetCollector.Core.csproj" />
    <ProjectReference Include="..\RepoSync.Core\RepoSync.Core.csproj" />
  </ItemGroup>
</Project>
