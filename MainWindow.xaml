<Window x:Class="RepoSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:bk="clr-namespace:BranchKit;assembly=BranchKit"
        Title="Repo Sync" Height="600" Width="900">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="GitHub profile:" VerticalAlignment="Center"/>
      <TextBox x:Name="UserBox" Width="150" Margin="6,0,12,0"/>
      <TextBlock Text="Token (optional):" VerticalAlignment="Center"/>
      <PasswordBox x:Name="TokenBox" Width="150" Margin="6,0,12,0"/>
      <Button x:Name="LoadBtn" Content="Load repos" Padding="12,2" Click="Load_Click"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="Local folder:" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,2" Click="Browse_Click"/>
      <TextBox x:Name="FolderBox" Margin="6,0,6,0"/>
    </DockPanel>
    <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
    <DataGrid x:Name="Grid" SelectionChanged="Grid_SelectionChanged" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Repo" Binding="{Binding Name}" IsReadOnly="True" Width="250"/>
        <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" IsReadOnly="True" Width="130"/>
        <DataGridTextColumn Header="Last commit" Binding="{Binding LastCommit}" IsReadOnly="True" Width="250"/>
        <DataGridTemplateColumn Header="">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><Button Content="Update" Padding="8,0" Margin="2" Click="RowUpdate_Click"/></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridCheckBoxColumn Header="Private" Binding="{Binding Private}" IsReadOnly="True"/>
        <DataGridTextColumn Header="Remote" Binding="{Binding RemoteState}" IsReadOnly="True" Width="220"/>
        <DataGridTextColumn Header="Last updated" Binding="{Binding LastUpdated, StringFormat=dd MMM yyyy HH:mm}" IsReadOnly="True" Width="120"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
    <DockPanel Grid.Column="2">
      <TextBlock x:Name="GraphInfo" DockPanel.Dock="Top" Margin="6,0,0,4" Foreground="Gray" Text="Select a repo to see its branches"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <bk:BranchGraphView x:Name="Graph" RowHeight="24" Background="White" Foreground="Black"/>
      </ScrollViewer>
    </DockPanel>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Select all" Padding="12,2" Click="SelectAll_Click"/>
      <Button Content="Select none" Padding="12,2" Margin="6,0" Click="SelectNone_Click"/>
      <Button x:Name="CheckBtn" Content="Check for updates" Padding="12,2" Margin="0,0,6,0" Click="Check_Click"/>
      <Button x:Name="UpdateBtn" Content="Pull latest &amp; checkout latest branch" Padding="12,2" Click="Update_Click"/>
      <TextBlock x:Name="CheckText" Margin="16,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="SavedText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
    </StackPanel>
  </Grid>
</Window>
